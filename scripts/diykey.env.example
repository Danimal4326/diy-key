# Settings for scripts/diykey_service.sh: copy to ~/.diy-key/<instance>/diykey.env ("main"
# for the first one) and edit. One KEY=value per line (no spaces around =, no quotes needed).
# Only DIYKEY_* keys are used. Edit, then touch the instance's restart file
# (~/.diy-key/main/restart) to apply.

# Identity: keep these stable once a console has adopted the device (it pins the cert in state/).
# A fresh one: MAC = FCECDA + 6 random hex digits, device ID and GUID from `uuidgen | tr A-Z a-z`.
DIYKEY_IFACE=en0
DIYKEY_MAC=FCECDA000001
DIYKEY_DEVICE_ID=00000000-0000-4000-8000-000000000001
DIYKEY_GUID=00000000-0000-4000-8000-000000000002
DIYKEY_HOSTNAME=diy-key
# DIYKEY_STATE_DIR is the instance's state/ folder unless set here.

# Each instance needs its own address: Protect reaches the AI Key's :8080 and :5432 on it. Add
# it to the interface first (not kept across reboots):
#   sudo ifconfig en0 alias 192.0.2.18 255.255.255.255
DIYKEY_BIND_IP=192.0.2.18

# Protect console (for the tokenless reconnect and the PostgreSQL access rule).
DIYKEY_CONSOLE_HOST=192.0.2.1

# PostgreSQL 17 + pgvector from Homebrew; scripts/diykey_pg_init.sh creates pg/.
# DIYKEY_PG_BIN=/opt/homebrew/opt/postgresql@17/bin
# Set to 0 to run without the instance's PostgreSQL.
# DIYKEY_PG=1

DIYKEY_DEBUG=false
# Factory firmware reported to Protect (getInfo, /api/info, ucp4 X-Version, discovery) until an
# update pins a newer one in state/fw_version.json, which then wins.
# DIYKEY_FW_VERSION=2.2.6
# DIYKEY_DISCOVERY_FW_VERSION=aikey.rk3588.v2.2.6.0.emu.260901.0000
# A Protect firmware update is simulated: DIY-Key stores the offered file in DIYKEY_FW_DIR
# (default ~/.diy-key/firmware; set DIYKEY_FW_DOWNLOAD=0 to skip), "installs" for
# DIYKEY_FAKE_UPDATE_S seconds (15), then pins the new version in state/fw_version.json.
# DIYKEY_FW_DIR=~/.diy-key/firmware
# DIYKEY_FW_DOWNLOAD=1
# DIYKEY_FAKE_UPDATE_S=15
# logs/diykey.log is rotated at this many MB, keeping this many old files.
# Read at service start: apply with a full restart, not the restart file.
# DIYKEY_LOG_MAX_MB=50
# DIYKEY_LOG_KEEP=5

# recognizeKeyFrames (Basic Understanding) tags key-moment frames with this COCO ONNX
# detector (Ultralytics anchor-free export, e.g. Frigate's yolov9-s-320.onnx). Unset: the
# result is an empty placeholder.
# DIYKEY_RAM_MODEL=/path/to/yolov9-s-320.onnx

# Find Anything. DIYKEY_CLIP=1 adds CLIP ViT-L/14 image embeddings to RAM results (what Protect's
# search queries) and text/image embeddings to the AI Key's nl-search connection, which DIY-Key
# opens while adopted (DIYKEY_NL_SEARCH=0 to skip). Needs torch + open_clip_torch (~1.7 GB of
# weights on first use). DIYKEY_RAM_TAGS: Protect's app/fixtures/ram_tags.csv, for query tags.
# DIYKEY_CLIP=1
# DIYKEY_RAM_TAGS=/path/to/ram_tags.csv
# DIYKEY_NL_SEARCH=1
